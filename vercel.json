{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "api": {
            "root": ".",
            "framework": "express",
            "buildCommand": "npm run build",
            "devCommand": "node --watch server.js"
        },
        "client": {
            "root": "client",
            "framework": "vite",
            "buildCommand": "npm run build",
            "devCommand": "vite dev"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client",
                "path": "/index.html"
            }
        }
    ],
    "bindings": [
        {
            "type": "service",
            "service": "client",
            "format": "url",
            "env": "CLIENT_URL"
        }
    ]
}